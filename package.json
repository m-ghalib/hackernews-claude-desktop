{
  "name": "hackernews-mcp",
  "version": "1.0.0",
  "description": "HackerNews MCP server for Claude Desktop",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "dist/index.js",
  "bin": {
    "hackernews-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run --exclude 'tests/network/**'",
    "test:network": "vitest run --config vitest.network.config.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.11.4",
    "cheerio": "^1.0.0",
    "undici": "^7.10.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.14.3",
    "@types/node": "^22.15.17",
    "tsup": "^8.4.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  }
}
